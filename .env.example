# Copy to .env and fill in. Never commit the real .env.
# Real environment variables always win over this file.

# ---------------------------------------------------------------- runtime
APP_ENV=production
LOG_LEVEL=info
HTTP_ADDR=:8080
WEBHOOK_PATH=/webhook/whatsapp

# ----------------------------------------------------------------- OpenAI
OPENAI_API_KEY=
# Model that writes the customer-facing answer.
OPENAI_MODEL=gpt-4o-mini
# Model used for the structured analysis that runs on every message. Leave it
# empty to reuse OPENAI_MODEL. Pointing it at a cheaper model is the single
# biggest cost lever: analysis runs on every message, generation does not.
OPENAI_CLASSIFIER_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=300
# Size of the recent-message window. Everything older is represented by the
# rolling summary, so the prompt does not grow with the conversation.
OPENAI_CONTEXT_MESSAGES=8
OPENAI_TIMEOUT_SECONDS=20
# Longest customer message forwarded to the model; longer text is truncated.
OPENAI_MAX_INPUT_CHARS=1200
# true = OpenAI writes the final WhatsApp answer after trigger/gate approval.
# false = use deterministic template replies only.
LLM_AGENT_REPLIES=true

# ------------------------------------------------- AI decisions and budget
# Below this confidence the bot asks a clarification or stays silent.
AI_MIN_CONFIDENCE=0.75
# Hard cap on model calls per contact per day.
AI_MAX_CALLS_PER_USER_PER_DAY=40
# true  = spend one call on a substantive message that matched no trigger
#         (catches leads phrased in words the trigger list does not cover)
# false = trigger-first mode: unmatched messages are dropped for free
AI_ANALYZE_UNMATCHED=true
AI_MIN_WORDS_UNMATCHED=3

# --------------------------------------------------------------- WhatsApp
# greenapi = native Green API polling, no incoming webhook required
# meta     = Meta Cloud API webhooks
WHATSAPP_PROVIDER=greenapi
WHATSAPP_TIMEOUT_SECONDS=15
# Random human-like delay before automatic customer replies only.
WHATSAPP_BOT_REPLY_DELAY_MIN_MS=1500
WHATSAPP_BOT_REPLY_DELAY_MAX_MS=3000

# ------------------------------------------------------ Green API polling
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
GREEN_API_API_URL=https://api.green-api.com
GREEN_API_POLLING_ENABLED=true
# Green API supports 5-60 seconds for receiveNotification long polling.
GREEN_API_RECEIVE_TIMEOUT_SECONDS=5
GREEN_API_RETRY_DELAY_SECONDS=5

# --------------------------------------------------------- Meta webhooks
# Required only when WHATSAPP_PROVIDER=meta.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Strongly recommended: without it webhook signatures are not verified.
WHATSAPP_APP_SECRET=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0

# ------------------------------------------------------------ lead handoff
# At least one of the two is required.
DIANA_WHATSAPP_PHONE=
DIANA_WHATSAPP_USER_ID=

# ----------------------------------------------------------------- storage
SQLITE_PATH=data/lawyer-bot.db

# ------------------------------------------------------------------ admins
ADMIN_TELEGRAM_IDS=

# -------------------------------------------------------------- processing
WORKER_COUNT=4
QUEUE_SIZE=256

# ----------------------------------------------------------------- switches
# true = run the whole pipeline but never actually send a WhatsApp message.
DRY_RUN=false
DEFAULT_LEAD_SOURCE=whatsapp
# Persist raw provider payloads in webhook_events for full auditability.
TRACE_RAW_PAYLOAD=true

# ================================================================ ADMIN CRM
# The consultant panel. It is served by the same binary at ADMIN_BASE_PATH and
# does not change how WhatsApp messages are received.
ADMIN_ENABLED=true
ADMIN_BASE_PATH=/admin

# First account, created ONLY when no account exists yet. After the first
# start these two are ignored, so restarting never resets a password.
# Minimum 10 characters, must contain a letter and a digit.
ADMIN_EMAIL=admin@example.kz
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

ADMIN_SESSION_HOURS=12
# Set to true whenever the CRM is reachable over HTTPS. It makes the session
# cookie Secure, so it is never sent over a plain connection.
ADMIN_SECURE_COOKIES=false
ADMIN_PBKDF2_ITERATIONS=600000
ADMIN_LOGIN_MAX_ATTEMPTS=10
ADMIN_LOCKOUT_THRESHOLD=8
ADMIN_LOCKOUT_MINUTES=15

# ------------------------------------------------------------------- media
# Conversation media (received and sent) is stored here, outside any public
# directory. Only allow-listed MIME types are accepted.
MEDIA_PATH=data/media
MEDIA_MAX_SIZE_MB=32
# Download inbound media from the provider and keep a local copy, because a
# provider link is not permanent.
MEDIA_DOWNLOAD_INBOUND=true

# -------------------------------------------------------------- follow-ups
# Durable, database-backed reminders. A restart never loses one.
FOLLOWUP_ENABLED=true
# Delays measured from the client's last message; one entry per stage.
FOLLOWUP_DELAYS=1h,6h,24h
FOLLOWUP_MAX_ATTEMPTS=3
FOLLOWUP_POLL_SECONDS=60
FOLLOWUP_BATCH_SIZE=20
FOLLOWUP_CLAIM_TTL_MINUTES=5
FOLLOWUP_RETRY_MINUTES=10
# Never nudge a client in the middle of the night.
FOLLOWUP_BUSINESS_HOURS_ONLY=true
FOLLOWUP_BUSINESS_START_HOUR=9
FOLLOWUP_BUSINESS_END_HOUR=21
FOLLOWUP_TIMEZONE=Asia/Almaty
