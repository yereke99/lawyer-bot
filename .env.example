# Copy to .env and fill in. Never commit the real .env.
# Real environment variables always win over this file.

# ---------------------------------------------------------------- runtime
APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080
WEBHOOK_PATH=/webhook/whatsapp

# ----------------------------------------------------------------- OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=300
OPENAI_CONTEXT_MESSAGES=10
OPENAI_TIMEOUT_SECONDS=20
# Longest customer message forwarded to the model; longer text is truncated.
OPENAI_MAX_INPUT_CHARS=1200

# ------------------------------------------------- AI decisions and budget
# Below this confidence the bot asks a clarification or stays silent.
AI_MIN_CONFIDENCE=0.75
# Hard cap on model calls per contact per day.
AI_MAX_CALLS_PER_USER_PER_DAY=40
# true  = spend one call on a substantive message that matched no trigger
#         (catches leads phrased in words the trigger list does not cover)
# false = strictest token saving: unmatched messages are dropped for free
AI_ANALYZE_UNMATCHED=true
AI_MIN_WORDS_UNMATCHED=3

# --------------------------------------------------------------- WhatsApp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Strongly recommended: without it webhook signatures are not verified.
WHATSAPP_APP_SECRET=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TIMEOUT_SECONDS=15

# ------------------------------------------------------------ lead handoff
# At least one of the two is required.
DIANA_WHATSAPP_PHONE=
DIANA_WHATSAPP_USER_ID=

# ----------------------------------------------------------------- storage
SQLITE_PATH=data/lawyer-bot.db

# ------------------------------------------------------------------ admins
ADMIN_TELEGRAM_IDS=

# -------------------------------------------------------------- processing
WORKER_COUNT=4
QUEUE_SIZE=256

# ----------------------------------------------------------------- switches
# true = run the whole pipeline but never actually send a WhatsApp message.
DRY_RUN=false
DEFAULT_LEAD_SOURCE=whatsapp
# Persist raw webhook bodies in webhook_events for full auditability.
TRACE_RAW_PAYLOAD=true
