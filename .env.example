# Copy to .env and fill in. Never commit the real .env.
# Real environment variables always win over this file.

# ---------------------------------------------------------------- runtime
APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080
WEBHOOK_PATH=/webhook/whatsapp

# ----------------------------------------------------------------- OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=300
OPENAI_CONTEXT_MESSAGES=10
OPENAI_TIMEOUT_SECONDS=20
# Longest customer message forwarded to the model; longer text is truncated.
OPENAI_MAX_INPUT_CHARS=1200
# true = OpenAI writes the final WhatsApp answer after trigger/gate approval.
# false = use deterministic template replies only.
LLM_AGENT_REPLIES=true

# ------------------------------------------------- AI decisions and budget
# Below this confidence the bot asks a clarification or stays silent.
AI_MIN_CONFIDENCE=0.75
# Hard cap on model calls per contact per day.
AI_MAX_CALLS_PER_USER_PER_DAY=40
# true  = spend one call on a substantive message that matched no trigger
#         (catches leads phrased in words the trigger list does not cover)
# false = trigger-first mode: unmatched messages are dropped for free
AI_ANALYZE_UNMATCHED=false
AI_MIN_WORDS_UNMATCHED=3

# --------------------------------------------------------------- WhatsApp
# greenapi = native Green API polling, no incoming webhook required
# meta     = Meta Cloud API webhooks
WHATSAPP_PROVIDER=greenapi
WHATSAPP_TIMEOUT_SECONDS=15
# Random human-like delay before automatic customer replies only.
WHATSAPP_BOT_REPLY_DELAY_MIN_MS=1500
WHATSAPP_BOT_REPLY_DELAY_MAX_MS=3000

# ------------------------------------------------------ Green API polling
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
GREEN_API_API_URL=https://api.green-api.com
GREEN_API_POLLING_ENABLED=true
# Green API supports 5-60 seconds for receiveNotification long polling.
GREEN_API_RECEIVE_TIMEOUT_SECONDS=5
GREEN_API_RETRY_DELAY_SECONDS=5

# --------------------------------------------------------- Meta webhooks
# Required only when WHATSAPP_PROVIDER=meta.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Strongly recommended: without it webhook signatures are not verified.
WHATSAPP_APP_SECRET=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0

# ------------------------------------------------------------ lead handoff
# At least one of the two is required.
DIANA_WHATSAPP_PHONE=
DIANA_WHATSAPP_USER_ID=

# ----------------------------------------------------------------- storage
SQLITE_PATH=data/lawyer-bot.db

# ------------------------------------------------------------------ admins
ADMIN_TELEGRAM_IDS=

# -------------------------------------------------------------- processing
WORKER_COUNT=4
QUEUE_SIZE=256

# ----------------------------------------------------------------- switches
# true = run the whole pipeline but never actually send a WhatsApp message.
DRY_RUN=false
DEFAULT_LEAD_SOURCE=whatsapp
# Persist raw provider payloads in webhook_events for full auditability.
TRACE_RAW_PAYLOAD=true
